<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>

	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<LangVersion>latest</LangVersion>
	<Version>0.1.2.6</Version>
	<Authors>Gabriel Dupont Muenchen</Authors>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<Description>A lightweight, convention-based object mapper for .NET focused on high performance and minimal configuration. Additional capabilities are being evaluated for future versions while maintaining strict performance goals.</Description>

	<PackageTags>mapping;performance;object-mapper;dotnet</PackageTags>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<RepositoryType>git</RepositoryType>
	<RepositoryUrl>https://github.com/duponto/Maply</RepositoryUrl>
	<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\"/>
	</ItemGroup>
</Project>
